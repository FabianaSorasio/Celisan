# --- Panel de administración ---
ADMIN_PASSWORD=
# Clave secreta para firmar la sesión de admin. Generar una nueva con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Google Sheets (opcional; sin esto la web usa data/catalogo-celisan-import.csv vía seed) ---
# 1) Importá data/catalogo-celisan-import.csv en sheets.google.com
# 2) Compartí la planilla: "Cualquier persona con el enlace" → Lector
# 3) Copiá el ID de la URL: https://docs.google.com/spreadsheets/d/ESTE_ID/edit
GOOGLE_SHEET_ID=

# Opcional: API key (Google Cloud → Sheets API). Si no la ponés, se usa export CSV público.
GOOGLE_SHEETS_API_KEY=

# Nombre de la pestaña y rango (la primera hoja suele llamarse "Hoja 1" en español)
GOOGLE_SHEET_RANGE=Hoja 1!A1:G500
